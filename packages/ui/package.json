{
  "name": "@timelinx/ui",
  "version": "1.0.0-beta.4",
  "description": "Modern browser-native React timeline UI. Drop-in components built on @timelinx/core and @timelinx/react.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./styles/structure": "./dist/structure.css",
    "./styles/structure.css": "./dist/structure.css",
    "./styles/tokens": "./dist/tokens.css",
    "./styles/tokens.css": "./dist/tokens.css",
    "./styles/presets/dark-pro": "./dist/presets/dark-pro.css",
    "./styles/presets/dark-pro.css": "./dist/presets/dark-pro.css",
    "./styles/presets/light": "./dist/presets/light.css",
    "./styles/presets/light.css": "./dist/presets/light.css",
    "./styles/presets/high-contrast": "./dist/presets/high-contrast.css",
    "./styles/presets/high-contrast.css": "./dist/presets/high-contrast.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist --skipLibCheck && cp src/tokens.css dist/ && sed 's|@import .\\.\\./tokens\\.css.|@import \"./tokens.css\";|' src/styles/structure.css > dist/structure.css && mkdir -p dist/presets && cp src/presets/*.css dist/presets/",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@timelinx/core": ">=1.0.0-beta.3",
    "@timelinx/react": ">=1.0.0-beta.6",
    "lucide-react": ">=0.300.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@timelinx/core": "workspace:*",
    "@timelinx/react": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^4.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.0.0",
    "vite": "^8.2.1",
    "vitest": "~4.1.10"
  },
  "keywords": [
    "timeline",
    "react",
    "nle",
    "davinci",
    "video-editor",
    "ui",
    "components",
    "typescript"
  ],
  "author": "Timeline Contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/maanaaasss/timelinx/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maanaaasss/timelinx",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/maanaaasss/timelinx/blob/main/packages/ui/README.md",
  "publishConfig": {
    "access": "public"
  }
}
