{
  "name": "timelinx",
  "version": "1.0.0",
  "description": "Browser-native timeline editor engine and UI",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:apps": "pnpm --filter @timelinx/demo build && pnpm --filter @timelinx/editor build && pnpm --filter @timelinx/creator-editor build && pnpm --filter @timelinx/podcast-editor build && pnpm --filter @timelinx/pro-timeline build && pnpm --filter @timelinx/template-editor build && pnpm --filter @timelinx/headless-example build && pnpm --filter @timelinx/nl-command-demo build && pnpm --filter @timelinx/collab-demo build",
    "dev": "pnpm --filter @timelinx/demo dev",
    "dev:editor": "pnpm --filter @timelinx/editor dev",
    "dev:creator": "pnpm --filter @timelinx/creator-editor dev",
    "dev:podcast": "pnpm --filter @timelinx/podcast-editor dev",
    "dev:pro": "pnpm --filter @timelinx/pro-timeline dev",
    "dev:template": "pnpm --filter @timelinx/template-editor dev",
    "dev:headless": "pnpm --filter @timelinx/headless-example dev",
    "dev:nl": "pnpm --filter @timelinx/nl-command-demo dev",
    "dev:collab": "pnpm --filter @timelinx/collab-demo dev",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "changeset": "changeset"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "overrides": {
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.29.4",
    "@eslint/js": "^9.28.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "eslint": "^9.28.0",
    "globals": "^16.5.0",
    "playwright": "^1.62.1",
    "prettier": "^3.5.0",
    "typescript-eslint": "^8.33.0"
  }
}
